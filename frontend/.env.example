# Dev-server proxy target for `/api` (leave empty to use the hosted API).
# Point at the bundled Laravel in ../backend to develop full-stack:
#   VITE_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_API_PROXY_TARGET=

# Public API (grocery app). Leave empty in dev to use Vite proxy.
VITE_API_BASE_URL=https://grocery.newcinderella.online

# Dev chat at /chat — loads product catalog from AI_CATALOG_API_BASE + Anthropic.
# VITE_API_BASE_URL does not affect chat while VITE_AI_MOCK=true.
VITE_AI_MOCK=true
AI_CATALOG_API_BASE=https://grocery.newcinderella.online

# Claude (server-only — no VITE_ prefix). Restart npm run dev after changes.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5
# VITE_AI_MOCK=true
